import (Queue) from "lib.zen"

Queue q

screen(q.isEmptyInt())
screen(q.sizeInt())

q.enqueueInt(10)
q.enqueueInt(20)
q.enqueueInt(30)

screen(q.isEmptyInt())
screen(q.sizeInt())
screen(q.peekInt())

screen(q.dequeueInt())
screen(q.dequeueInt())

screen(q.peekInt())
screen(q.sizeInt())

q.enqueueBool(true)
q.enqueueBool(false)

screen(q.isEmptyBool())
screen(q.sizeBool())
screen(q.peekBool())
screen(q.dequeueBool())
screen(q.dequeueBool())
screen(q.isEmptyBool())

q.enqueueDouble(3.14)
q.enqueueDouble(6.28)

screen(q.sizeDouble())
screen(q.peekDouble())
screen(q.dequeueDouble())
screen(q.dequeueDouble())
screen(q.isEmptyDouble())

q.enqueueLong(100L)
q.enqueueLong(200L)

screen(q.sizeLong())
screen(q.peekLong())
screen(q.dequeueLong())
screen(q.dequeueLong())
screen(q.isEmptyLong())

q.enqueueByte(10B)
q.enqueueByte(20B)

screen(q.sizeByte())
screen(q.peekByte())
screen(q.dequeueByte())
screen(q.dequeueByte())
screen(q.isEmptyByte())

q.enqueueString("hello")
q.enqueueString("world")

screen(q.sizeString())
screen(q.peekString())
screen(q.dequeueString())
screen(q.dequeueString())
screen(q.isEmptyString())
